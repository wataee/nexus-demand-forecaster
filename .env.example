# Application Configuration
APP_NAME="Nexus Demand Forecaster"
ENVIRONMENT=production
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql://user:password@postgres:5432/demand_forecasting
DB_HOST=postgres
DB_PORT=5432
DB_NAME=demand_forecasting
DB_USER=user
DB_PASSWORD=password

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_DOCS_ENABLED=true

# Security
SECRET_KEY=nexus-forecasting-production-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Forecasting Configuration
FORECAST_HORIZON_MONTHS=12
TIME_SERIES_FREQUENCY=monthly
DEFAULT_MODEL=MovingAverage
